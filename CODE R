# Fungsi Jackknife Manual untuk menghitung rata-rata dan SE
jackknife_analysis <- function(data) {
  n <- length(data)
  theta_full <- mean(data, na.rm = TRUE) 
  theta_i <- numeric(n) 

  # Perulangan untuk setiap subsampel (menghilangkan satu data pada setiap iterasi)
  for (i in 1:n) {
    subsample <- data[-i] 
    theta_i[i] <- mean(subsample, na.rm = TRUE) 
  }

  # Rata-rata dari estimasi leave-one-out (Theta dot)
  theta_dot <- mean(theta_i, na.rm = TRUE)

  # Estimasi Bias Jackknife
  bias_jack <- (n - 1) * (theta_dot - theta_full)

  # Estimasi Varians Jackknife
  var_jack <- ((n - 1) / n) * sum((theta_i - theta_dot)^2, na.rm = TRUE)

  # Estimasi Standar Error (SE) Jackknife
  se_jack <- sqrt(var_jack)

  return(list(
    mean_full = theta_full,
    bias_estimate = bias_jack,
    std_error = se_jack,
    jackknife_values = theta_i
  ))
}

